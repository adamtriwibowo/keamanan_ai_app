# Salin file ini ke .env di root aplikasi (sudah dilakukan otomatis oleh setup-vps.sh)
# lalu isi semua nilai di bawah ini sebelum menjalankan pm2.

# Ganti kalau port ini sudah dipakai aplikasi lain di VPS ini!
# Cek dulu dengan: sudo ss -tulpn | grep LISTEN
PORT_EXPRESS=3000
PORT_GRAPHQL=5000

# API key OpenRouter (untuk fitur Analisis AI) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API key SerpApi (untuk scan NIK/telepon/email) — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# MongoDB lokal di VPS ini (database terpisah dari aplikasi lain lewat nama db)
MONGODB_URI=mongodb://127.0.0.1:27017/keamananai

# WAJIB diganti untuk produksi — jangan pakai nilai default di kode.
# Generate contoh: openssl rand -hex 32
JWT_SECRET=
